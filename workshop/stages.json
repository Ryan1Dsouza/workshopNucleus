{
  "schema": 1,
  "baseFiles": [
    "vercel.json",
    "scripts/build-web.mjs",
    "package.json",
    "package-lock.json",
    ".gitignore",
    "AGENTS.md",
    ".agents/**",
    "skills-lock.json",
    "README.md",
    "licenses/**",
    "docs/**",
    "workshop/**",
    "public/stage.mjs",
    "scripts/workshop/files.mjs",
    "scripts/workshop/build-kit.mjs",
    "scripts/workshop/stage.mjs",
    "scripts/workshop/verify.mjs",
    "scripts/audit/browser-options.mjs",
    "scripts/audit/stage.mjs"
  ],
  "stages": [
    {
      "id": 1,
      "title": "Host and Bluetooth pairing",
      "minutes": 10,
      "files": [
        "server/**",
        "native/**",
        "scripts/native/**",
        "public/host/**",
        "public/ui/**",
        "public/ui/**",
        "public/vendor/**",
        "public/downloads/**",
        "public/core/controller-contract.js",
        "public/core/kart-roster.json",
        "public/core/controller-state.js",
        "public/core/orientation.js",
        "public/core/one-euro.js",
        "public/core/ble-protocol.js",
        "public/core/bluetooth-link.js",
        "public/core/diagnostics.js",
        "tests/helpers/**",
        "tests/server.test.mjs",
        "tests/lobbies.test.mjs",
        "tests/ble-protocol.test.mjs",
        "tests/bluetooth-link.test.mjs",
        "tests/controller-contract.test.mjs",
        "tests/controller-state.test.mjs",
        "tests/download-origin.test.mjs",
        "tests/workshop-files.test.mjs"
      ],
      "outcome": "The neutral host loads; two isolated BLE slots accept assigned phone profiles. APK/native foundations are supplied."
    },
    {
      "id": 2,
      "title": "Wii-style buttons",
      "minutes": 10,
      "files": [
        "public/controller/index.html",
        "public/controller/phone.css",
        "public/controller/phone-ui.mjs",
        "public/games/controller-lab/**"
      ],
      "outcome": "The shared remote and input lab show multi-touch presses/releases without stuck buttons."
    },
    {
      "id": 3,
      "title": "Motion and centering",
      "minutes": 10,
      "files": [
        "public/controller/sensors.mjs",
        "public/core/pose-pointer.js",
        "public/core/motion-input.js",
        "public/core/blade-display.js",
        "tests/sensors.test.mjs",
        "tests/motion-input.test.mjs",
        "tests/controller-motion.test.mjs",
        "scripts/audit/motion-view.mjs",
        "tests/diagnostics.test.mjs",
        "tests/blade-display.test.mjs"
      ],
      "outcome": "Native wrist motion moves a calibrated aim; centering uses a captured pose and never creates a cut."
    },
    {
      "id": 4,
      "title": "Profiles and game adapters",
      "minutes": 10,
      "files": [
        "public/core/controller-profiles.js",
        "public/core/game-registry.js",
        "public/games/catalog.mjs",
        "tests/game-registry.test.mjs"
      ],
      "outcome": "Profiles define actions/layouts; adapters share one lifecycle and input contract."
    },
    {
      "id": 5,
      "title": "Fruit Ninja integration",
      "minutes": 15,
      "files": [
        "public/games/fruit-ninja/**",
        "public/games/mario-kart/**",
        "tests/kart-curb.test.mjs",
        "public/assets/**",
        "tests/multiplayer.test.mjs",
        "public/core/audio.js",
        "public/core/net.js",
        "public/core/phone-link.js",
        "public/core/relay-link.js",
        "public/core/transport.js",
        "public/core/room.js",
        "public/core/motion-clock.js",
        "public/core/motion-queue.js",
        "public/core/preferences.js",
        "public/core/input-links.js",
        "public/core/render-budget.js",
        "public/core/screen-blade.js",
        "public/core/blade-ribbon.js",
        "public/core/trail.js",
        "scripts/audit/filter.mjs",
        "tests/audio-resources.test.mjs",
        "tests/blade-ribbon.test.mjs",
        "tests/effect-budget.test.mjs",
        "tests/game-logic.test.mjs",
        "scripts/audit/fruit-game.mjs",
        "tests/filter.test.mjs",
        "tests/pose-pointer.test.mjs",
        "tests/render-budget.test.mjs"
      ],
      "outcome": "The supplied OpenWii game uses the shared controller for motion slicing, scoring, practice/Classic and restart."
    },
    {
      "id": 6,
      "title": "Your own game extension",
      "minutes": 10,
      "files": [
        "public/games/extension-template/**"
      ],
      "outcome": "A working button-counter adapter template demonstrates adding another profile without rebuilding the phone app."
    },
    {
      "id": 7,
      "title": "Verification and packaging",
      "minutes": 10,
      "files": [
        "scripts/workshop/export.mjs",
        "scripts/audit/controller.mjs",
        "scripts/audit/multiplayer.mjs",
        "scripts/audit/kart-party.mjs",
        "scripts/audit/ble-steering.mjs",
        "tests/ble-steering.test.mjs",
        "tests/motion-clock.test.mjs",
        "tests/motion-queue.test.mjs"
      ],
      "outcome": "Cumulative checks pass and a clean source export is created; retained transport references are included. Real Android/iPhone checks are reported separately."
    }
  ]
}
